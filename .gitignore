# === Mac 系统特有缓存（强迫症必挡） ===
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# === Python 编译垃圾与缓存 ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# === IDE 与编辑器临时配置文件 ===
.vscode/
.idea/
*.swp
*.swo

# === 视频测试大文件（防止把几十兆的录像错推上云端挤爆仓库） ===
*.mp4
*.avi
*.mkv
*.mov

# === 模型权重（体积大，各机器自备；YOLO 首次运行会自动下载） ===
*.pt
*.pth
*.onnx
*.engine
*.rknn

# === Python 虚拟环境（Mac 上按需自建，别提交） ===
.venv/
venv/

# === 本机专属配置，不入库 ===
local/
# 临时探针脚本与日志（WSL 里跑的一次性命令都放这里）
.scratch/
# 仿真资产：Fuel 下载的人形模型（几 MB 二进制，各机器 sim/setup.sh 自取）
sim/assets/
*.local.md
.env

# === 数据集与训练产物（体积大，各机器自己生成） ===
datasets/
data/
runs/
